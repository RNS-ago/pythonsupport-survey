# The server's settings: the only place to change them. The deploy scripts (deploy/lib/common.sh)
# and systemd (pis-survey.service) read this file, and so does Django, through the service and
# manage.py. Secrets and values that differ per server are in backend/.env instead (see
# "Changing settings" in docs/operations.md). Change a value here, commit, and deploy with
# `manage.sh update`.
#
# Plain NAME=value lines: no $OTHER_NAME (systemd doesn't expand it), and quotes around values
# with spaces. The notebooks read DATABASE_NAME from here too (pis_lib.connect), and
# deploy/db-permissions.sql gets ANALYST_ROLE, VIEWER_ROLE and APP_USER as psql variables.

APP_DIR=/srv/pythonsupport-survey
# The system user Django runs as.
APP_USER=pis
SERVICE=pis-survey
# The PostgreSQL database. Without it (local development) Django uses the SQLite file
# backend/pythonsupport/db.sqlite3.
DATABASE_NAME=pis_survey
# The server's group for the people working on this project (gid 15118 on psqdb).
DEV_GROUP=pythonsupport
# The database role the developers' logins get (deploy/db-permissions.sql defines its rights).
ANALYST_ROLE=pis_analyst
# The read-only database role for viewers, who are added by hand (see docs/data-analysis.md).
VIEWER_ROLE=pis_viewer
# gunicorn's port; nginx forwards to it.
PORT=2810

# Root-only, so a compromised app (running as pis) can't delete or change the backups.
BACKUP_DIR=/var/backups/pis-survey
# The database holds student numbers: keep copies only as long as the retention policy allows.
KEEP_DAYS=30
# When the daily backup runs (cron format: minute hour day month weekday).
BACKUP_SCHEDULE="0 3 * * *"

# Runs notebooks/pipeline.py, which rebuilds the processed tables and the dashboard.
PIPELINE_USER=pis-pipeline
# When the pipeline runs (cron format): every hour from 8:00 to 16:00, and at midnight.
PIPELINE_SCHEDULE="0 0,8-16 * * *"
# Where the pipeline writes the dashboard and /admin/dashboard/ reads it. pis can only read its
# folder.
DASHBOARD_HTML=/var/lib/pis-dashboard/dashboard.html
